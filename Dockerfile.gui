# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.gui — Servicio Streamlit (Interfaz gráfica) para Cloud Run
#
# IMPORTANTE: Cloud Run SIEMPRE expone el contenedor en PORT=8080
# y le inyecta la variable PORT al proceso. NO usar ENV PORT en el Dockerfile.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Código fuente (solo lo necesario para la GUI)
COPY app_gui.py .
COPY image_processor.py .

# Configuración de Streamlit
RUN mkdir -p /root/.streamlit
COPY deploy/streamlit_config.toml /root/.streamlit/config.toml

ENV PYTHONUNBUFFERED=1
# NO fijamos PORT — Cloud Run lo inyecta como 8080

EXPOSE 8080

# Cloud Run espera escuchar en $PORT (siempre 8080)
# Streamlit debe usar ESE puerto
CMD ["sh", "-c", "echo \"Starting Streamlit on PORT=$PORT\" && python -m streamlit run app_gui.py \
    --server.port=${PORT} \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --server.enableCORS=false \
    --server.enableXsrfProtection=false"]
