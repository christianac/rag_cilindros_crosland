# ============================================
# Configuración del Sistema RAG de Cilindros
# ============================================

# Google Gemini API
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Qdrant Cloud
# Obtén tus credenciales en: https://cloud.qdrant.io/
# La URL debe ser algo como: https://xxx-xxx.aws.cloud.qdrant.io:6333
QDRANT_CLOUD_URL=https://tu-cluster.qdrant.io:6333
QDRANT_API_KEY=tu_api_key_de_qdrant_aqui

# API Server Configuration (opcional)
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False

# ============================================
# Notas:
# - Nunca subas el archivo .env a git
# - Mantén tus API keys seguras
# - Para Qdrant Cloud, usa el tier gratuito para empezar
# - Gemini tiene un tier gratuito generoso
# ============================================