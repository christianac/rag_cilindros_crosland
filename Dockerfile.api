# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.api — Servicio Flask (RAG API) para Cloud Run
#
# IMPORTANTE: Cloud Run SIEMPRE expone el contenedor en PORT=8080
# y le inyecta la variable PORT al proceso. NO usar ENV PORT en el Dockerfile
# porque eso sobrescribe el valor de Cloud Run.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# Dependencias del sistema (Pillow necesita libgl)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Código fuente (solo lo necesario para la API)
COPY api_server.py .
COPY image_processor.py .
COPY qdrant_setup.py .

ENV PYTHONUNBUFFERED=1
# NO fijamos PORT aquí — Cloud Run inyecta PORT=8080 en runtime

# Cloud Run espera escuchar en $PORT (siempre 8080)
EXPOSE 8080

# El CMD usa $PORT directamente (inyectado por Cloud Run)
CMD ["sh", "-c", "echo \"Starting API on PORT=$PORT\" && python api_server.py"]
